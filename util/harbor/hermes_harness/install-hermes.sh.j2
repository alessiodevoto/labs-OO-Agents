#!/usr/bin/env bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y curl git ripgrep xz-utils ca-certificates python3 python3-venv python3-pip
BRANCH="{{ version }}"
if [ -z "$BRANCH" ] || [ "$BRANCH" = "None" ]; then BRANCH="v2026.6.19"; fi
curl -fsSL https://raw.githubusercontent.com/NousResearch/hermes-agent/main/scripts/install.sh | bash -s -- --skip-setup --branch "$BRANCH"
export PATH="$HOME/.local/bin:$PATH"
export HERMES_HOME="${HERMES_HOME:-/tmp/hermes}"
mkdir -p "$HERMES_HOME" "$HERMES_HOME/sessions" "$HERMES_HOME/skills" "$HERMES_HOME/memories"
hermes version || hermes --version
