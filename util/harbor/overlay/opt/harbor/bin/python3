#!/bin/sh
# Arch-aware Python 3 wrapper for the harbor bootstrap overlay.
# Uses aarch64 native Python when the container has the aarch64 ELF interpreter;
# otherwise falls back to the container's own Python3.
#
# Note: uname -m always returns 'aarch64' on the host kernel even inside
# x86_64 containers, so we cannot use it to detect container arch.
# Instead we check for the aarch64 ELF interpreter (ld-linux-aarch64.so.1).
AARCH64_PYTHON=/opt/harbor/cpython312-aarch64/bin/python3.12
# User-base for pip --user installs (pip3 wrapper uses the same path).
# /tmp is isolated per container (Apptainer --containall), so this is trial-safe.
AARCH64_USERBASE=/tmp/aarch64-pip-user
if [ -f /lib/ld-linux-aarch64.so.1 ] || [ -f /lib/aarch64-linux-gnu/ld-linux-aarch64.so.1 ]; then
    export PYTHONUSERBASE="$AARCH64_USERBASE"
    exec "$AARCH64_PYTHON" "$@"
fi
# aarch64 ld.so not found; x86_64 container — use container Python
for _py in /usr/local/bin/python3 /usr/bin/python3 /usr/local/bin/python3.13 /usr/local/bin/python3.12 /usr/local/bin/python3.11 /usr/local/bin/python3.10 /usr/bin/python3.13 /usr/bin/python3.12 /usr/bin/python3.11 /usr/bin/python3.10; do
    [ -x "$_py" ] && exec "$_py" "$@"
done
echo 'python3: no Python found in container or overlay' >&2
exit 127
